# Виртуальное окружение и кэши Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# КОШЕЛЬКИ: keystore-файлы никогда не попадают в git
# (они зашифрованы паролем, но репозиторий — не место для них)
keystore/

# Колеса зависимостей для офлайн-установки
wheels/

# Локальные артефакты
*.log
.DS_Store

# README — часть проекта (глобальный ~/.gitignore игнорирует все *.md)
!README.md
!README_RU.md
